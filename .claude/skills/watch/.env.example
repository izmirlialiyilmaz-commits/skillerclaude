# Transcription providers — only needed for videos that lack native captions
# (raw .mp4 files, Looms, some Instagram reels). Set either one or both;
# ElevenLabs Scribe is preferred when both are present.

# - ElevenLabs Scribe: https://elevenlabs.io/app/settings/api-keys (~$0.40/hr)
# - Groq Whisper:      https://console.groq.com/keys              (~$0.04/hr, free tier)
ELEVENLABS_API_KEY=
GROQ_API_KEY=

# Force a specific provider (otherwise picks ElevenLabs if its key is set).
# WATCH_TRANSCRIBER=elevenlabs
# WATCH_TRANSCRIBER=groq

# Cost-estimate overrides (USD per minute of audio for transcription, USD per
# million tokens for Claude). Defaults are reasonable for Opus 4.7 + Scribe v1.
# WATCH_RATE_ELEVEN_PER_MIN=0.0067
# WATCH_RATE_GROQ_PER_MIN=0.0007
# WATCH_RATE_CLAUDE_INPUT_PER_MTOK=15
# WATCH_RATE_CLAUDE_OUTPUT_PER_MTOK=75
# WATCH_TOKENS_PER_FRAME=1300
